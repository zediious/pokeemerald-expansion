mapscripts OldaleTown_Mart_MapScripts {}

script GerbonTown_PokeMart_Employee {
    lock
    msgbox("Welcome!
            How may I serve you?")
    waitmessage
    if (var(VAR_ZED_STORY_TRACKER) >= 6)
    {
        pokemart(GerbonTown_PostRoute110__MartItems)
    }
    else
    {
        pokemart(GerbonTown_PreRoute110__MartItems)
    }
    msgbox("Please come again!")
    waitmessage
    release
    end
}

mart GerbonTown_PreRoute110__MartItems {
    ITEM_POKE_BALL
    ITEM_POTION
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_BURN_HEAL
    ITEM_AWAKENING
    ITEM_REPEL
    ITEM_SUPER_REPEL
    ITEM_MAX_REPEL
}

mart GerbonTown_PostRoute110__MartItems {
    ITEM_POKE_BALL
    ITEM_GREAT_BALL
    ITEM_POTION
    ITEM_SUPER_POTION
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_BURN_HEAL
    ITEM_AWAKENING
    ITEM_REPEL
    ITEM_SUPER_REPEL
    ITEM_MAX_REPEL
}

//// NPCs

// School kid who wants Super Potions
script GerbonMart_SuperPotionSchoolKid{
    lock
    faceplayer
    setspeaker("School Kid")
    msgbox("I really need some {COLOR RED}Super Potions{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}, but
            they won't sell me any! Just take my
            money!")
    if (var(VAR_ZED_STORY_TRACKER) >= 6)
    {
        waitmessage
        setspeaker("School Kid")
        msgbox("...
        
                What! They sell them to you! What's so
                special about you!")
    }
    waitmessage
    release
    applymovement(GERBON_SUPERPOTION_KID, moves(face_up))
    end
}

// Old man at right shelves
script GerbonMart_RightShelfOldMan{
    lock
    faceplayer
    setspeaker("Old Man")
    msgbox("If you don't want to encounter
            any Pokemon, buy a Repel!
            
            The Repels around here are better than
            in other regions. Our basic Repel lasts
            for 500 steps, and are a great value!")
    waitmessage
    release
    end
}
