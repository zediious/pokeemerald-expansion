mapscripts ZED_SawgrassVillage_PokemonCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Sawgrass_PokemonCenter_OnTransition
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script Sawgrass_PokemonCenter_OnTransition {
    setrespawn(HEAL_LOCATION_LITTLEROOT_TOWN)
    end
}

script SawgrassVillage_Pokecenter_Nurse {
    setvar(VAR_0x800B, 1)
    call(Common_EventScript_PkmnCenterNurse)
    waitmessage
    waitbuttonpress
    release
    end
}

script SawgrassVillage_HealerChansey {
    lock
    playmoncry(SPECIES_CHANSEY, CRY_MODE_NORMAL)
    msgbox("Chans-eee")
    waitmoncry
    waitmessage
    closemessage
    release
}

//// NPCs

// Kid by bookshelf
script SawgrassPokemonCenter_BookshelfKid {
    lock
    faceplayer
    setspeaker("Kid")
    msgbox("They always have new books here!
            Pokemon Centers are the best!")
    waitmessage
    release
    end
}

// Girl at right table
script SawgrassPokemonCenter_TableGirl {
    lock
    faceplayer
    setspeaker("Girl")
    msgbox("If you use that PC over there, you
            can store your Pokemon on a virtual
            network! Technology is crazy!")
    waitmessage
    release
    end
}

// Dude on chair
script SawgrassPokemonCenter_ChairDude{
    lock
    faceplayer
    setspeaker("Tired Man")
    msgbox("Whew! I spent all day walking. I'm glad
            the Pokemon Centers let you relax for
            as long as you need!")
    waitmessage
    release
    end
}