mapscripts WoltiaCity_Mart_MapScripts {}

script WoltiaCity_PokeMart_Employee {
    lock
    msgbox("Welcome!
            How may I serve you?")
    waitmessage
    pokemart(WoltiaCity_MartItems)
    msgbox("Please come again!")
    waitmessage
    release
    end
}

mart WoltiaCity_MartItems {
    ITEM_POKE_BALL
    ITEM_GREAT_BALL
    ITEM_POTION
    ITEM_SUPER_POTION
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_BURN_HEAL
    ITEM_AWAKENING
    ITEM_REPEL
    ITEM_SUPER_REPEL
}