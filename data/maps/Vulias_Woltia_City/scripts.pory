mapscripts Vulias_Woltia_City_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ZED_STORY_TRACKER, 16: Vulias_Woltia_City_MapScript_OnFrameEnableJordanTourney
        VAR_ZED_STORY_TRACKER, 18: WoltiaCity_JordanGoToIgris
        VAR_WOLTIA_DISABLETRAINERS_TRIGGER, 0: Vulias_Woltia_City_MapScript_OnFrameDisableTourneyTrainers
    ]
    MAP_SCRIPT_ON_TRANSITION: WoltiaCity_DisableReportersBeforeValid
}

script Vulias_Woltia_City_MapScript_OnFrameDisableTourneyTrainers {
    setvar(VAR_WOLTIA_DISABLETRAINERS_TRIGGER, 1)
    setflag(FLAG_WOLTIA_TOURNEY_TRAINER01)
    setflag(FLAG_WOLTIA_TOURNEY_TRAINER02)
    setflag(FLAG_WOLTIA_TOURNEY_TRAINER03)
    setflag(FLAG_WOLTIA_TOURNEY_TRAINER04)
    setflag(FLAG_WOLTIA_TOURNEY_TRAINER05)
    end
}

script Vulias_Woltia_City_MapScript_OnFrameEnableJordanTourney {
    setvar(VAR_ZED_STORY_TRACKER, 17)
    addobject(WOLTIA_JORDAN_TRIGGERTOURNEY)
    setflag(FLAG_WOLTIATOURNEY_ENABLED)
    end
}

script WoltiaCity_DisableReportersBeforeValid
{
    if (var(VAR_ZED_STORY_TRACKER) < 19)
    {
        setflag(FLAG_WOLTIA_INTERVIEW01_INTERVIEWCREW)
        setflag(FLAG_WOLTIA_SINVESTAEMP_OUTSIDE)
        removeobject(WOLTIA_INTERVIEW01_INTERVIEWER)
        removeobject(WOLTIA_INTERVIEW01_CAMERAMAN)
    }
}

// Dude that blocks that Aerodrome door
script WoltiaCity_EventScript_AerodromeBlockers {
    lock
    setspeaker("Guard")
    msgbox("Not allowed in when there's no match
            going on.
            
            Come back another time.")
    waitmessage
    release
    end
}

// Player talk to Jordan if they try to go in Aerodrome early
script WoltiaCity_EventScript_JordanTriggerOldRuinVisit_TriggerIfEnter {
    lock
    applymovement(WOLTIA_JORDAN_TRIGGERTOURNEY, moves(emote_exclamation_mark, face_right))
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down, face_left))
    waitmovement
    goto(WoltiaCity_EventScript_JordanTriggerOldRuinVisit)
}

// Start Old Ruin visit before tourney by speaking to Jordan outside hall
// As well, start tourney after Old ruin encounter
script WoltiaCity_EventScript_JordanTriggerOldRuinVisit {
    setspeaker("Jordan")
    if (var(VAR_ZED_STORY_TRACKER) == 17) {
        lock
        faceplayer
        msgbox("Ready to go? They are letting in
                tournament entrants now!", MSGBOX_YESNO)
        waitmessage
        if (var(VAR_RESULT) == YES) {
            setflag(FLAG_WOLTIA_TOURNEY_TRAINER01)
            setflag(FLAG_WOLTIA_TOURNEY_TRAINER02)
            setflag(FLAG_WOLTIA_TOURNEY_TRAINER03)
            setflag(FLAG_WOLTIA_TOURNEY_TRAINER04)
            setflag(FLAG_WOLTIA_TOURNEY_TRAINER05)
            setspeaker("Jordan")
            msgbox("Nice! I'm excited about this!
            
                    You bet we'll see each other at the end!
                    I won't let you get me this time!")
            waitmessage
            setvar(VAR_WOLTIA_TOURNAMENT_STATE, 1)
            warp(MAP_WOLTIA_CITY_BATTLE_HALL_PREP_ROOM, 4, 5)
            waitstate
            release
            end
        } else {
            setspeaker("Jordan")
            msgbox("Got it! You should definitely hurry, I
                    don't want you to miss it!")
            release
            end
        }
    }
    else {
        lock
        faceplayer
        msgbox("{PLAYER}! The tournament is still not
                set to start for a little bit, we have
                some time to kill.
                
                Let's go check out the {COLOR RED}Old Ruin{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}, right
                there next to {COLOR RED}The Aerodrome{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}.
                
                Oh, by the way, that's the name of the
                {COLOR RED}Battle Hall{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} here in Woltia City, pretty
                cool huh?
                
                Lead the way! It's just up ahead!")
        waitmessage
        // Not battling with partner here.
        setfollowernpc(
            WOLTIA_JORDAN_TRIGGERTOURNEY,
            FOLLOWER_NPC_FLAG_CAN_LEAVE_ROUTE,
            WoltiaCity_EventScript_JordanFollowerKeeganEncounter,
            PARTNER_JORDAN_PANSEAR_03
        )
        setvar(VAR_ZED_STORY_TRACKER, 15)
        questupdated(0)
        release
        end
    }
    
    
}

script WoltiaCity_EventScript_JordanFollowerKeeganEncounter {
    lock
    faceplayer
    setspeaker("Jordan")
    msgbox("Let's go to the {COLOR RED}Old Ruin{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}! It's just to
            the right of the giant building right
            there!")
    waitmessage
    release
    end
}

// Prevent leaving top half of city during encounter
script WoltiaCity_EventScript_NoLeaveWhileFollower {
    checkfollowernpc
    if (var(VAR_RESULT) == YES) {
        lock
        setspeaker("Jordan")
        msgbox("Where you going? It won't take long,
                let's go check out the {COLOR RED}Old Ruin{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}!
                
                It's just to right of the giant building
                on the north side of the city!")
        waitmessage
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up))
        waitmovement
        release
    }
    end
}

// Same as above but south. This is very lazy
script WoltiaCity_EventScript_NoLeaveWhileFollowerSouth {
    checkfollowernpc
    if (var(VAR_RESULT) == YES) {
        lock
        setspeaker("Jordan")
        msgbox("Where you going? It won't take long,
                let's go check out the {COLOR RED}Old Ruin{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}!
                
                It's just to right of the giant building
                on the north side of the city!")
        waitmessage
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down))
        waitmovement
        release
    }
    end
}

// Player won tourney, Jordan heads off to Igris Desert
script WoltiaCity_JordanGoToIgris {
    setvar(VAR_ZED_STORY_TRACKER, 19)
    lock
    applymovement(WOLTIA_JORDAN_TRIGGERTOURNEY, moves(face_right))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    waitmovement
    setspeaker("Jordan")
    msgbox("You did it again {PLAYER}!
            I've just got to keep getting stronger
            so I can beat you one day! Your
            Pokemon really love you, it shows.
            
            You're probably going to make the
            news, it's very rare tha-")
    waitmessage
    call(WoltiaCity_SinvestaTalkToPlayer)
    setspeaker("Jordan")
    msgbox("So, what did they say!
    
            ...
            
            Oh man! That's amazing news! If they've
            got their eye on you, they're probably
            considering you as a Battle Ace!
            
            Like I was saying, it's incredibly rare
            for someone to beat two Battle Aces! I
            think only four people have ever done
            that besides you! I guess we've got to
            see how far you can take it!
            
            Oh but don't you worry, I'm going to end
            up stopping you short! My Pokemon and I
            are going to get so strong, you won't
            believe it!
            
            Anyways, let's not waste any more time!
            The next Battle Hall is in Liordun
            Town, which is a litle bit past
            the Igris Desert. The desert is pretty
            big though, it might take us some time!
            
            I'm going to go ahead of you, but we'll
            probably see each other there! Catch
            you later!")
    applymovement(WOLTIA_JORDAN_TRIGGERTOURNEY, moves(walk_down * 12))
    waitmovement
    delay(30)
    setvar(VAR_INTERVIEWS_STORY, 3)
    setflag(FLAG_WOLTIA_JORDAN_OUTSIDETOURNEY)
    clearflag(FLAG_WOLTIA_INTERVIEW01_INTERVIEWCREW)
    addobject(WOLTIA_INTERVIEW01_INTERVIEWER)
    addobject(WOLTIA_INTERVIEW01_CAMERAMAN)
    removeobject(WOLTIA_JORDAN_TRIGGERTOURNEY)
    questupdated(0)
    release
    end
}

script WoltiaCity_SinvestaTalkToPlayer
{
    addobject(WOLTIA_SINVESTA_EMPLOYEE)
    applymovement(WOLTIA_JORDAN_TRIGGERTOURNEY, moves(face_up, emote_exclamation_mark))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up, emote_exclamation_mark))
    playse(SE_PIN)
    applymovement(WOLTIA_AERODROME_BLOCKER, moves(walk_left))
    delay(20)
    applymovement(WOLTIA_SINVESTA_EMPLOYEE, moves(walk_down))
    waitmovement(WOLTIA_AERODROME_BLOCKER)
    applymovement(WOLTIA_AERODROME_BLOCKER, moves(face_right))
    waitmovement(WOLTIA_SINVESTA_EMPLOYEE)
    waitse
    setspeaker("???")
    msgbox("{PLAYER}, if I could have a moment of
            your time, please.")
    waitmessage
    applymovement(WOLTIA_JORDAN_TRIGGERTOURNEY, moves(face_right))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    setspeaker("Jordan")
    msgbox("Ooo, look at you! You're really making
            waves! I'll wait here!")
    waitmessage
    applymovement(WOLTIA_SINVESTA_EMPLOYEE, moves(walk_right * 4, walk_up, face_down))
    delay(10)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up, walk_right * 4, face_up))
    waitmovement(WOLTIA_SINVESTA_EMPLOYEE)
    applymovement(WOLTIA_AERODROME_BLOCKER, moves(walk_right, face_down))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    setspeaker("???")
    msgbox("Ahem, thank you for your time. I am a
            representative of {COLOR RED}Sinvesta, the
            organization behind the tournament you
            have just participated in.")
    waitmessage
    setspeaker("Sinvesta Representative")
    msgbox("Seeing as you have now won both the
            Palladium and Aerodrome tournaments, I
            wanted to congratulate you personally.
            
            This is a rare achievement, only a...
            select few, have ever made such a mark.
            
            It is our understanding that you wish
            to participate in further tournaments
            in other locations, as well. We'll be
            watching you with great interest.
            
            Have a good day, {PLAYER}.")
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down, face_up))
    closemessage
    delay(10)
    applymovement(WOLTIA_SINVESTA_EMPLOYEE, moves(walk_down, walk_left * 2))
    waitmovement
    applymovement(WOLTIA_AERODROME_BLOCKER, moves(walk_left, face_right))
    waitmovement
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down, walk_left * 4, walk_up, face_left))
    applymovement(WOLTIA_SINVESTA_EMPLOYEE, moves(walk_left * 2, walk_up))
    waitmovement
    applymovement(WOLTIA_AERODROME_BLOCKER, moves(walk_right, face_down))
    playse(SE_DOOR)
    removeobject(WOLTIA_SINVESTA_EMPLOYEE)
    waitse
    waitmovement
    waitmovement(OBJ_EVENT_ID_PLAYER)
}

script WoltiaCity_InterviewAfterWoltiaWin_Trigger01
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right, walk_down * 2))
    goto(WoltiaCity_InterviewAfterWoltiaWin)
}

script WoltiaCity_InterviewAfterWoltiaWin_Trigger02
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down * 2))
    goto(WoltiaCity_InterviewAfterWoltiaWin)
}

script WoltiaCity_InterviewAfterWoltiaWin_Trigger03
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left, walk_down * 2))
    goto(WoltiaCity_InterviewAfterWoltiaWin)
}

script WoltiaCity_InterviewAfterWoltiaWin_Trigger04
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 3, walk_down * 2))
    goto(WoltiaCity_InterviewAfterWoltiaWin)
}

script WoltiaCity_InterviewAfterWoltiaWin_Trigger05
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 4, walk_down * 2))
    goto(WoltiaCity_InterviewAfterWoltiaWin)
}

script WoltiaCity_InterviewAfterWoltiaWin
{
    applymovement(WOLTIA_INTERVIEW01_INTERVIEWER, moves(walk_right))
    applymovement(WOLTIA_INTERVIEW01_CAMERAMAN, moves(walk_right))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark, face_left))
    playse(SE_PIN)
    waitse
    setspeaker("Interviewer")
    call(BattleHall_EventScript_InterviewStart)
    lock
    setspeaker("Interviewer")
    msgbox("Thank you for your time! We hope to see
            you again soon!")
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up, face_down))
    closemessage
    waitmovement
    applymovement(WOLTIA_INTERVIEW01_INTERVIEWER, moves(walk_right, walk_down * 10))
    delay(30)
    applymovement(WOLTIA_INTERVIEW01_CAMERAMAN, moves(walk_right, walk_down * 10))
    waitmovement(WOLTIA_INTERVIEW01_CAMERAMAN)
    removeobject(WOLTIA_INTERVIEW01_CAMERAMAN)
    removeobject(WOLTIA_INTERVIEW01_INTERVIEWER)
    setvar(VAR_INTERVIEWS_STORY, 4)
    release
}
