mapscripts Vulias_Liordun_Town_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_6, 0: LiordunTown_MapScript_OnWarpCrowd
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ZED_STORY_TRACKER, 27: LiordunTown_EventScript_AfterKowtowDisappears
    ]
    MAP_SCRIPT_ON_RESUME: LiordunTown_MapScript_OnResume
}

script LiordunTown_MapScript_OnWarpCrowd
{
    if (var(VAR_ZED_STORY_TRACKER) >= 24) // TODO: && <= <var_value_after_everything_done>
    {
        call(LiordunTown_EventScript_CreateGroups)
        call(LiordunTown_EventScript_CreateBattles)
        call(LiordunTown_EventScript_CreateCrowd)
    }
}


// Handle re-drawing crowd when returning from bag menu, etc
script LiordunTown_MapScript_OnResume
{
    call(LiordunTown_SetMapState)
    if (var(VAR_ONRESUME_DRAWCROWD) == 1)
    {   
        setvar(VAR_ONRESUME_DRAWCROWD, 0)
        call(LiordunTown_EventScript_CreateGroups)
        call(LiordunTown_EventScript_CreateBattles)
        call(LiordunTown_EventScript_CreateCrowd)
    }
    // Use hectic music during the raid if leaving and re-entering map before completing
    if ((var(VAR_ZED_STORY_TRACKER) >= 25) && (var(VAR_ZED_STORY_TRACKER) < 28)) // TODO: && <= <var_value_after_everything_done>
    {
        playbgm(MUS_ENCOUNTER_AQUA, TRUE)
    }
}

// Set metatiles based on story state (this town changes a lot)
script LiordunTown_SetMapState
{
    switch (var(VAR_ZED_STORY_TRACKER))
    {
        case (28):
            setmetatile(44, 27, 0x031, 0)
            setmetatile(44, 28, 0x039, 0)
    }
    special(DrawWholeMapView)
}

// Triggers for player first entry
script LiordunTown_EventScript_PlayerFirstEnterTrigger01
{
    setobjectxy(LIORDUN_HECTIC_WARNER, 25, 27)
    goto(LiordunTown_EventScript_PlayerFirstEnterScene)
}

script LiordunTown_EventScript_PlayerFirstEnterTrigger02
{
    setobjectxy(LIORDUN_HECTIC_WARNER, 25, 28)
    goto(LiordunTown_EventScript_PlayerFirstEnterScene)
}

script LiordunTown_EventScript_PlayerFirstEnterTrigger03
{
    setobjectxy(LIORDUN_HECTIC_WARNER, 25, 29)
    goto(LiordunTown_EventScript_PlayerFirstEnterScene)
}

script LiordunTown_EventScript_PlayerFirstEnterTrigger04
{
    setobjectxy(LIORDUN_HECTIC_WARNER, 25, 30)
    goto(LiordunTown_EventScript_PlayerFirstEnterScene)
}

script LiordunTown_EventScript_PlayerFirstEnterTrigger05
{
    setobjectxy(LIORDUN_HECTIC_WARNER, 25, 31)
    goto(LiordunTown_EventScript_PlayerFirstEnterScene)
}

// Player enters for first time
script LiordunTown_EventScript_PlayerFirstEnterScene
{
    lock
    setvar(VAR_ZED_STORY_TRACKER, 25)
    playbgm(MUS_ENCOUNTER_AQUA, TRUE)
    applymovement(LIORDUN_HECTIC_WARNER, moves(walk_fast_left * 7))
    waitmovement
    setspeaker("Woman")
    msgbox("I wouldn't go that way! Some thugs are
            trashing the whole town! I don't want
            any part in that! I came to Vulias for
            tournaments, not this!")
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up, face_down))
    waitmovement
    applymovement(LIORDUN_HECTIC_WARNER, moves(walk_fast_left * 10))
    waitmovement
    removeobject(LIORDUN_HECTIC_WARNER)
    removeobject(LIORDUNHECTIC_JORDANLATE)
    setflag(FLAG_LIORDUNHECTIC_JORDANLATE)
    questupdated(0)
    release
    end
}

// Player speaks to police blocking way north
script LiordunTown_EventScript_PlayerSpeakBlockingCop
{
    lock
    faceplayer
    setspeaker("Policeman")
    msgbox("Stay back! We'll have this under control
            soon, please follow the instructions of
            the organiz-")
    waitmessage
    applymovement(LIORDUN_HECTIC_BLOCKING_COP, moves(emote_exclamation_mark))
    playse(SE_PIN)
    waitse
    waitmovement
    setspeaker("Policeman")
    msgbox("Wait! You're that trainer who won the
            Woltia and Gerbon tournaments! That
            ain't happened in a long time, and you're
            all over the news!
            
            I reckon you can help out here, these
            Kowtow scum trashed the whole town,
            the Liordun Town Battle Ace is battling
            their 'head honcho' up ahead.
            
            No reason for me to keep you here!")
    waitmessage
    applymovement(LIORDUN_HECTIC_BLOCKING_COP, moves(walk_up, walk_right, face_left))
    waitmovement
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 3))
    waitmovement
    applymovement(LIORDUN_HECTIC_BLOCKING_COP, moves(walk_left, walk_down))
    waitmovement
    setflag(FLAG_LIORDUN_HECTIC_TALKEDCOP)
    goto(LiordunTown_EventScript_PlayerStoppedByGrunts)
}

// Player walks forward, stopped by the grunts
script LiordunTown_EventScript_PlayerStoppedByGrunts
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 3))
    // battles on side of player end, despawn their mons into Pokeballs
    // Happens while player is walking
    applymovement(LIORDUN_HECTIC_MON01, moves(enter_pokeball))
    applymovement(LIORDUN_HECTIC_MON02, moves(enter_pokeball))
    applymovement(LIORDUN_HECTIC_MON03, moves(enter_pokeball))
    applymovement(LIORDUN_HECTIC_MON04, moves(enter_pokeball))
    waitmovement
    removeobject(LIORDUN_HECTIC_MON01)
    removeobject(LIORDUN_HECTIC_MON02)
    removeobject(LIORDUN_HECTIC_MON03)
    removeobject(LIORDUN_HECTIC_MON04)
    setflag(FLAG_LIORDUN_HECTIC_KOWTOWGRUNTMONS)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    // kowtow grunts jump in front and behind player
    playse(SE_BIKE_HOP)
    applymovement(LIORDUN_HECTIC_JUMPGRUNT01, moves(jump_2_right, face_up))
    applymovement(LIORDUN_HECTIC_JUMPGRUNT02, moves(jump_2_left, face_down))
    waitmovement
    setspeaker("Kowtow Grunt")
    msgbox("Where do you think you're going?
            Like we would let you past!")
    waitmessage
    trainerbattle_two_trainers(
        TRAINER_GRUNT_AQUA_HIDEOUT_7,
        "You don't know what you're doing!",
        TRAINER_GRUNT_AQUA_HIDEOUT_8,
        "Bah! We never get our way!"
    )
    goto(LiordunTown_EventScript_HecticGruntJumpBattleAfter)
}

script LiordunTown_EventScript_HecticGruntJumpBattleAfter
{
    setspeaker("Kowtow Grunt")
    msgbox("If only the boss would let us go wild...
    
            Get out of my sight!")
    waitmessage
    applymovement(LIORDUN_HECTIC_JUMPGRUNT01, moves(walk_left * 2, face_right))
    applymovement(LIORDUN_HECTIC_JUMPGRUNT02, moves(walk_right * 2, face_left))
    waitmovement
    // player advances forward to the admin and battle ace
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 2, walk_right * 2, walk_up))
    waitmovement
    setspeaker("???")
    msgbox("Wah? You're here to help?
    
            ...")
    waitmessage
    setspeaker("Calvin")
    msgbox("Ah, the one from the TV! The name is
            {COLOR RED}Calvin!{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}!
            
            Help me out here would you? These rough
            scoundrels think they can get what
            they want by force!")
    waitmessage
    applymovement(LIORDUN_HECTIC_KOWTOWADMIN, moves(jump_in_place_right * 2))
    waitmovement
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right, walk_up * 2, walk_left))
    setspeaker("Kowtow Admin")
    msgbox("Aghhhh! Needed some help did you
            grandpa! You'll regret this kid!")
    waitmovement
    waitmessage
    special(ChooseHalfPartyForBattle)
	waitstate
    goto(LiordunTownHectic_RawScript_Start2v2)
    release
}

script LiordunTownHectit_EventScript_CalvinFollower {nop} // We will never be able to interact with them

// Initiate 2v2 Battle with Grunts VS Player and Jordan
// Notably, this has no issues being performed while having a follower.
// Poryscript does not appear to have a shorthand for this.
raw
`
LiordunTownHectic_RawScript_Start2v2::
    multi_2_vs_2 TRAINER_GRUNT_MT_CHIMNEY_1, LiordunTownHectic_AdminLoss, TRAINER_GRUNT_AQUA_HIDEOUT_6, LiordunTownHectic_Grunt_Loss, PARTNER_CALVIN_LIORDUNHECTIC
    goto(LiordunTownHectic_RawScript_AfterMultiDirect)

LiordunTownHectic_RawScript_AfterMultiDirect::
    switch VAR_RESULT
	case 1, LiordunTown_Hectic_AdminAfterBattle
	goto LiordunTown_Hectic_AdminWhiteout

LiordunTownHectic_AdminLoss:
    .string "This cannot stand!$"

LiordunTownHectic_Grunt_Loss:
    .string "How could we lose!$"
`

script LiordunTown_Hectic_AdminWhiteout {
    fadescreenswapbuffers(FADE_TO_BLACK)
    cleartrainerflag(TRAINER_GRUNT_AQUA_HIDEOUT_7)
    cleartrainerflag(TRAINER_GRUNT_AQUA_HIDEOUT_8)
    special(SetCB2WhiteOut)
}

script LiordunTown_Hectic_AdminAfterBattle
{
    lock
    applymovement(LIORDUN_HECTIC_KOWTOWADMIN, moves(
        jump_in_place_right, jump_in_place_down * 2, jump_in_place_right))
    waitmovement
    setspeaker("Kowtow Admin")
    msgbox("Rahh! Unacceptable! For you of all
            people to succumb to Sinvesta's wishes
            Calvin, it's pathetic!
            
            You all cheer for these toy crowns while
            Vulias' bones rot beneath our feet!
            
            You'll regret your choices soon enough.
            
            ...Kowtow, let's move out!")
    waitmessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    playse(SE_M_DOUBLE_TEAM)
    setflag(FLAG_LIORDUNHECTIC_KOWTOW)
    removeobject(LIORDUN_HECTIC_BLOCKING_COP)
    removeobject(LIORDUN_HECTIC_JUMPGRUNT01)
    removeobject(LIORDUN_HECTIC_JUMPGRUNT02)
    removeobject(LIORDUN_HECTIC_KOWTOWADMIN)
    removeobject(LIORDUN_HECTIC_CALVINMON)
    delay(60)

    // Because I don't want to write a function to delete vobjects, we do the following
    // 1. Set flag that prevents creating the vobjects for the battling grunts, cops, and their mons
    // 2. Warp the player to the same spot they're standing after the blackout
    // 3. Player warps back in, the other vobjects draw again but the battlers are gone
    setflag(FLAG_LIORDUNHECTIC_DRAWBATTLERS)
    setvar(VAR_ZED_STORY_TRACKER, 26)
    warp(MAP_VULIAS_LIORDUN_TOWN, 43, 16)
    setvar(VAR_ZED_STORY_TRACKER, 27)
    waitstate
    end
}

// Accessed via warp map script after the warp above completes
script LiordunTown_EventScript_AfterKowtowDisappears
{
    setvar(VAR_ZED_STORY_TRACKER, 28)
    call(LiordunTown_SetMapState)
    fadedefaultbgm
    applymovement(LIORDUN_HECTIC_CALVIN_BATTLE, moves(face_up))
    setspeaker("Calvin")
    msgbox("They're gone! Looks like the officers
            are chasing after them...I have my
            doubts regarding their success.
            
            I cannot thank you enough...
            {PLAYER}, was it? I can't say for sure
            I would have made it through that by
            myself.
            
            That...girl. The leader. There's an
            element of truth to her words. Our
            Battle Hall is ancient, and has stood
            since time lost to history. There are a
            good few folks in our own town, and
            elsewhere, that lament me allowing
            {COLOR RED}Sinvesta{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} to use it for their
            tournaments.
            
            Bahh...they don't realize that without
            the money, the Hall would have fallen
            into disarray years ago! It doesn't feel
            right, but what else can we do?

            Wow! Look at me go! You're very kind for
            indulging me a moment there. Thank you
            for your assistance here.")
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark, face_down))
    applymovement(LIORDUN_HECTIC_CALVIN_BATTLE, moves(emote_exclamation_mark, face_down))
    playse(SE_PIN)
    addobject(LIORDUNHECTIC_JORDANLATE)
    applymovement(LIORDUNHECTIC_JORDANLATE, moves(walk_fast_up * 7, face_right))
    waitmovement
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(LIORDUN_HECTIC_CALVIN_BATTLE, moves(face_left))
    setspeaker("Jordan")
    msgbox("{PLAYER}! I should have known you
            would be helping here! Looks like
            I'm a little late to the party...")
    waitmessage
    setspeaker("Calvin")
    msgbox("Hoho, you didn't miss much don't worry!
            You two must be friends?
            
            Well, I have to attend some business in
            the Hall, I hope I'll see you again soon!")
    waitmessage
    applymovement(LIORDUN_HECTIC_CALVIN_BATTLE, moves(walk_right, walk_up * 4, walk_left * 2, walk_up * 2))
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    applymovement(LIORDUNHECTIC_JORDANLATE, moves(face_up))
    waitmovement(LIORDUN_HECTIC_CALVIN_BATTLE)
    removeobject(LIORDUN_HECTIC_CALVIN_BATTLE)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(LIORDUNHECTIC_JORDANLATE, moves(face_right))
    waitmovement
    setspeaker("Jordan")
    msgbox("That's Calvin! Did you battle with him?
            Awesome! Those Kowtow goons got what
            was coming to them then!
            
            ...
            
            Really? People are saying that? I guess
            I can see why some people don't like
            the tournaments, but it's all just good
            fun, right? Besides, doing all of...
            this, to prove that point is just wrong!
            
            ...something to think about I guess.
            
            Anyways! It looks like they're going to
            delay the tournament because of this,
            so I say we go check out the {COLOR RED}Mine{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} back
            on Route 104!
            
            They allow visitors to the safe areas, I
            hear there are tons of cool things down
            there, and Pokemon!
            
            I'll meet you there, definitely rest up
            if you need too! See you soon!")
    applymovement(LIORDUNHECTIC_JORDANLATE, moves(walk_down * 10))
    delay(60)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(LIORDUNHECTIC_JORDANLATE)
    removeobject(LIORDUNHECTIC_JORDANLATE)
    questupdated(0)
    release
}

//// Fluff NPCs during initial entry

// Bemused Gentleman
script LiordunTown_EventScript_HecticGentleman
{
    lock
    faceplayer
    setspeaker("Gentleman")
    msgbox("Monsterous behavior! Just look at the
            state of this place! Those {COLOR RED}Kowtow{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}
            goons ought to be ashamed of
            themselves!")
    waitmessage
    release
    end
}

// Brother calming little sister
script LiordunTown_EventScript_HecticBrotherCalmingSister 
{
    if (var(VAR_ZED_STORY_TRACKER) < 28)
    {
        lock
        setspeaker("Youngster")
        msgbox("Don't worry! Just keep close to me and
                it will be over soon!")
        waitmessage
        setspeaker("Little Girl")
        msgbox("Wahhh! I'm scared! They hurt that Old
                Man! They're gonna hurt us! Wahhh!")
        waitmessage
        setspeaker("Youngster")
        msgbox("Not while you've got me! Don't worry!")
        waitmessage
        release
        end
    }
    elif ((var(VAR_ZED_STORY_TRACKER) >= 28) && (var(VAR_ZED_STORY_TRACKER) <= 30))
    {
        lock
        setspeaker("Youngster")
        msgbox("See! Everything's alright now!")
        waitmessage
        setspeaker("Little Girl")
        msgbox("Sniff, thank you big brother!")
        waitmessage
        setspeaker(NULL)
        msgbox("The sight touches your heart.")
        waitmessage
        release
        end
    }
}

// Old Woman helping injured Old Man
script LiordunTown_EventScript_HecticOldCoupleHelping
{
    if (var(VAR_ZED_STORY_TRACKER) < 28)
    {
        lock
        setspeaker("Old Woman")
        msgbox("Stay down dear! That leg of yours needs
                to be looked at, we have to wait for
                this chaos to die down!")
        waitmessage
        setspeaker("Old Man")
        msgbox("I'll be fine! Watch thi--ACK!!")
        waitmessage
        release
        end
    }
    elif ((var(VAR_ZED_STORY_TRACKER) >= 28) && (var(VAR_ZED_STORY_TRACKER) <= 30))
    {
        lock
        setspeaker("Old Woman")
        msgbox("Now we need to wait for the Ambulance
                dear, don't you dare try to get up yet!")
        waitmessage
        setspeaker("Old Man")
        msgbox("No! That will cost so mu--ACK!!")
        waitmessage
        release
        end
    }
}

// Conflicted Hex Maniac
script LiordunTown_EventScript_HecticHexManiacConflicted
{
    lock
    faceplayer
    setspeaker("Hex Maniac")
    msgbox("Those {COLOR RED}Kowtow{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} folks make a good
            point, but they take it too far!
            
            None of this will help anything...")
    waitmessage
    release
    end
}

// Market employee hiding
script LiordunTown_EventScript_HecticHidingEmployee
{
    lock
    faceplayer
    setspeaker("Mart Employee")
    msgbox("Not only did they trash the steets, but
            they robbed me of my Pokemon Vitamins!
            
            Pure scoundrels!")
    waitmessage
    release
    end
}

// Father calming his two children
script LiordunTown_EventScript_HecticFatherCalmingChildren
{
    if (var(VAR_ZED_STORY_TRACKER) < 28)
    {
        lock
        setspeaker("Man")
        msgbox("Settle down you two! Let's let the
                Police do their job!")
        waitmessage
        setspeaker("Little Girl")
        msgbox("But what about the tournament!")
        waitmessage
        turnvobject(30, DIR_WEST)
        setspeaker("Little Boy")
        msgbox("I don't want to miss it!")
        waitmessage
        setspeaker("Man")
        msgbox("We'll just have to wait and see!")
        waitmessage
        turnvobject(30, DIR_EAST)
        release
        end
    }
    elif ((var(VAR_ZED_STORY_TRACKER) >= 28) && (var(VAR_ZED_STORY_TRACKER) <= 30))
    {
        lock
        setspeaker("Little Girl")
        msgbox("So do we get to see the tournament!")
        waitmessage
        turnvobject(30, DIR_WEST)
        setspeaker("Little Boy")
        msgbox("Let's go daddy let's go!")
        waitmessage
        setspeaker("Man")
        msgbox("Pipe it down! It may be delayed!")
        waitmessage
        setspeaker("Little Boy and Girl")
        msgbox("Wahhh!")
        turnvobject(30, DIR_EAST)
        delay(10)
        turnvobject(30, DIR_WEST)
        delay(10)
        turnvobject(30, DIR_EAST)
        release
        end
    }
}

// Angry crowd does not respond
script LiordunTown_EventScript_AngryCrowdInteract
{
    if (var(VAR_ZED_STORY_TRACKER) < 28)
    {
        lock
        msgbox("The crowd does not budge to your
                pushing.")
        waitmessage
        release
        end
    }
    elif ((var(VAR_ZED_STORY_TRACKER) >= 28) && (var(VAR_ZED_STORY_TRACKER) <= 30))
    {
        call(LiordunTown_EventScript_CrowdRandomBark)
    }
}

// Below two used for two crowd members who are moved out of the way to allow passage
script LiordunTown_EventScript_AngryCrowdInteract_Special01
{
    if (var(VAR_ZED_STORY_TRACKER) < 28)
    {
        lock
        msgbox("The crowd does not budge to your
                pushing.")
        waitmessage
        release
        end
    }
}

script LiordunTown_EventScript_AngryCrowdInteract_Special02
{
    if ((var(VAR_ZED_STORY_TRACKER) >= 28) && (var(VAR_ZED_STORY_TRACKER) <= 30))
    {
        call(LiordunTown_EventScript_CrowdRandomBark)
