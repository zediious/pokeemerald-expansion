}

// Father calming his two children
script LiordunTown_EventScript_HecticFatherCalmingChildren
{
    lock
    setspeaker("Man")
    msgbox("Settle down you two! Let's let the
            Police do their job!")
    waitmessage
    setspeaker("Little Girl")
    msgbox("But what about the tournament!")
    waitmessage
    turnvobject(30, DIR_WEST)
    setspeaker("Little Boy")
    msgbox("I don't want to miss it!")
    waitmessage
    setspeaker("Man")
    msgbox("We'll just have to wait and see!")
    waitmessage
    turnvobject(30, DIR_EAST)
    release
    end
}

