    release
    end
}

// Brother calming little sister
script LiordunTown_EventScript_HecticBrotherCalmingSister 
{ // TODO: Make this not do anything after the kowtow leave liordun town
    lock
    setspeaker("Youngster")
    msgbox("Don't worry! Just keep close to me and
            it will be over soon!")
    waitmessage
    setspeaker("Little Girl")
    msgbox("Wahhh! I'm scared! They hurt that Old
            Man! They're gonna hurt us! Wahhh!")
    waitmessage
    setspeaker("Youngster")
    msgbox("Not while you've got me! Don't worry!")
    waitmessage
    release
    end
}

// Old Woman helping injured Old Man
script LiordunTown_EventScript_HecticOldCoupleHelping
{ // TODO: Make this not do anything after the kowtow leave liordun town
