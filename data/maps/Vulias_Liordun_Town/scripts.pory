// Market employee hiding
script LiordunTown_EventScript_HecticHidingEmployee
{
    lock
    faceplayer
    setspeaker("Mart Employee")
    msgbox("Not only did they trash the steets, but
            they robbed me of my Pokemon Vitamins!
            
            Pure scoundrels!")
    waitmessage
