mapscripts OldaleTown_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ZED_STORY_TRACKER, 2: GerbonTownBattleHall_OutdoorBattleStart
        VAR_ZED_STORY_TRACKER, 9: GerbonTownTourney_JordanAfter
    ]

    MAP_SCRIPT_ON_TRANSITION: GerbonTown_MapScript_OnTransition
}

script GerbonTown_MapScript_OnTransition {
    if (var(VAR_GERBON_BATTLEHALL_DISABLES_TRIGGER) == 0) {
        goto(GerbonTown_BattleHallDisables)
    }
    call(GerbonTown_Restaurant_Prepare)
    call(GerbonTown_DisableReportersBeforeValid)
    end
}


script GerbonTown_DisableReportersBeforeValid
{
    if (var(VAR_ZED_STORY_TRACKER) < 9)
    {
        setflag(FLAG_GERBON_INTERVIEW01_INTERVIEWCREW)
        removeobject(GERBON_INTERVIEW01_INTERVIEWER)
        removeobject(GERBON_INTERVIEW01_CAMERAMAN)
    }
}

// Prepare Restaraunt for another session
script GerbonTown_Restaurant_Prepare {
    setvar(VAR_RESTARAUNT_STATE, 0)
    setflag(FLAG_GERBON_WAITER_T1_01)
}

// Disables elements of the palladium show until it's been initiated
script GerbonTown_BattleHallDisables{
    setflag(FLAG_CANDACE01_MON2)
    setflag(FLAG_GERBON_BATTLEHALL_JORDAN01)
    setflag(FLAG_GERBON_TOWN_JORDAN_FIRSTBATTLE)
    setflag(FLAG_GERBON_TOWN_BLOCKERS)
    setflag(FLAG_GERBON_JORDAN_TOURNEY_OUTSIDE)
    removeobject(GERBONBATTLEHALL_CANDACE_01_MANTINE, MAP_GERBON_TOWN_BATTLE_HALL)
    removeobject(GERBON_BATTLEHALL_JORDAN_01, MAP_GERBON_TOWN_BATTLE_HALL)
    removeobject(GERBON_TOWN_JORDAN_FIRSTBATTLE, MAP_OLDALE_TOWN)
    removeobject(GERBON_PALLADIUM_BLOCKER_1, MAP_OLDALE_TOWN)
    removeobject(GERBON_PALLADIUM_BLOCKER_2, MAP_OLDALE_TOWN)

    // Disable the Palladium tournament battlers
    setflag(FLAG_GERBON_TOURNEY_TRAINER01)
    setflag(FLAG_GERBON_TOURNEY_TRAINER02)
    setflag(FLAG_GERBON_TOURNEY_TRAINER03)
    setflag(FLAG_GERBON_TOURNEY_TRAINER04)
    setflag(FLAG_GERBON_TOURNEY_TRAINER05)

    // Disable events that only appear after tourney completes
    setflag(FLAG_GERBONTOURNEY_ENABLED)

    // Prevent from triggering again
    setvar(VAR_GERBON_BATTLEHALL_DISABLES_TRIGGER, 1)
    end
}

// Near entrances to town
script GerbonTown_EventScript_TownSign {
    lockall
    msgbox("Gerbon Town
    
            Home of the Palladium")
    releaseall
}

// Restaraunt sign
script GerbonTown_EventScript_RestarauntSign {
    lockall
    msgbox("The Sassy Salazzle
    
            Battle and Dine!")
    releaseall
}

// Sign to Route 110
script GerbonTown_EventScript_Route110Sign {
    lockall
    msgbox("{DOWN_ARROW} To Route 110")
    releaseall
}

// Sign on flower bed
script GerbonTown_EventScript_KeepOffFlowers {
    lockall
    msgbox("Keep off the flowers!")
    releaseall
}

// Hidden Poke Ball with
script GerbonTown_EventScript_HiddenItemBall {
    lock
    giveitem(ITEM_EXP_CANDY_S, 2)
    removeobject(GERBON_CANDY_BALL)
    setflag(FLAG_GERBON_HIDDENITEMBALL)
    release
    end
}

// Dudes that block that Palladium doors
script GerbonTown_EventScript_PalladiumBlockers {
    lock
    setspeaker("Guard")
    msgbox("Not allowed in when there's no match
            going on.
            
            Come back another time.")
    waitmessage
    release
    end
}

// Woman angry about south blocking battle
script GerbonTown_EventScript_MadWoman {
    lock
    faceplayer
    setspeaker("Angry Woman")
    msgbox("These trainers! Breaking out into a
            battle wherever they please!
            
            Don't they know they're blocking
            the way? They won't listen!")
    waitmessage
    release
    end
}

// Battle scene blocking south exit
script GerbonTown_EventScript_BlockingBattleScene {
    lock
    setspeaker("Battler 1")
    msgbox("Lillipup! Use your Tackle attack!")
    waitmessage
    playmoncry(SPECIES_LILLIPUP, CRY_MODE_NORMAL)
    applymovement(GERBON_BLOCKER_BATTLER1_MON, moves(jump_in_place_right))
    delay(20)
    applymovement(GERBON_BLOCKER_BATTLER2_MON, moves(face_right))
    delay(10)
    applymovement(GERBON_BLOCKER_BATTLER2_MON, moves(face_left))
    playmoncry(SPECIES_SALANDIT, CRY_MODE_NORMAL)
    waitmoncry
    waitmovement
    setspeaker("Battler 2")
    msgbox("Salandit, don't take that!
            Use your Scratch attack!")
    waitmessage
    playmoncry(SPECIES_SALANDIT, CRY_MODE_NORMAL)
    applymovement(GERBON_BLOCKER_BATTLER2_MON, moves(jump_in_place_left))
    delay(20)
    applymovement(GERBON_BLOCKER_BATTLER1_MON, moves(face_left))
    delay(10)
    applymovement(GERBON_BLOCKER_BATTLER1_MON, moves(face_right))
    playmoncry(SPECIES_LILLIPUP, CRY_MODE_NORMAL)
    waitmoncry
    waitmovement
    msgbox("They don't seem to notice you")
    waitmessage
    release
    end
}

script GerbonTown_EventScript_KidTrigger01 {
    setvar(VAR_GERBON_FIRST_VISIT_POSITION, 0)
    goto(GerbonTown_EventScript_KidRunIntoPlayer)
}

script GerbonTown_EventScript_KidTrigger02 {
    setvar(VAR_GERBON_FIRST_VISIT_POSITION, 1)
    goto(GerbonTown_EventScript_KidRunIntoPlayer)
}

// Kid running into player to tell them about battle in Palladium. "Crashkid"
script GerbonTown_EventScript_KidRunIntoPlayer {
    lock
    if (var(VAR_GERBON_FIRST_VISIT_POSITION) == 0) {
        applymovement(GERBON_KID_RUNNING_CRASH, GerbonTown_CrashKid_Move01)
        waitmovement
    }
    else {
        applymovement(GERBON_KID_RUNNING_CRASH, GerbonTown_CrashKid_Move02)
        waitmovement
    }

    playse(SE_PIN)
    delay(60)
    setspeaker("Reckless Child")
    msgbox("Ouch, that hurt!

            I'm sorry, I'm just so excited for the
            battle in the {COLOR RED}Palladium{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}, it's going to be
            so cool!
            
            You should go watch it, the {COLOR RED}Palladium{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} is
            on the east side of town.
            
            Gotta go!")
    waitmessage
    applymovement(GERBON_KID_RUNNING_CRASH, GerbonTown_CrashKid_RunAway)
    waitmovement
    removeobject(GERBON_KID_RUNNING_CRASH)
    setflag(FLAG_GERBON_CRASH_KID)
    setvar(VAR_GERBON_FIRST_VISIT_TRIGGERS, 1)
    release
    end
}

// ******** CRASH KID MOVEMENTS
movement GerbonTown_CrashKid_Move01 {
    walk_faster_left * 7,
    walk_in_place_faster_left,
    emote_double_exclamation_mark
}

movement GerbonTown_CrashKid_Move02 {
    walk_faster_down,
    walk_faster_left * 7,
    walk_in_place_faster_left,
    emote_double_exclamation_mark
}

movement GerbonTown_CrashKid_RunAway {
    walk_faster_right * 8
}
// ******** CRASH KID MOVEMENTS

// First battle with Rival Jordan after Palladium fight
script GerbonTownBattleHall_OutdoorBattleStart {
    lock
    setvar(VAR_ZED_STORY_TRACKER, 3)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    waitmovement
    setspeaker("Jordan")
    msgbox("{PLAYER}! That was the best match
        I've seen yet! I am glad you were able
        to see it!
        
        Awhh, it's got me hyped up! Let's
        battle right now {PLAYER}!")
    waitmessage

    goto(GerbonTown_OutdoorBattleJordanAsk)

}

script GerbonTown_OutdoorBattleJordanAsk {
    setspeaker("Jordan")
    msgbox("Don't worry if you lose, I'll heal
        your Pokemon right away!", MSGBOX_YESNO)

    // Choose rival Pokemon based on starter
    if (var(VAR_RESULT) == YES) {
        goto(GerbonTown_OutdoorBattleTrigger)
    } else{
        msgbox("No fun! Come on, a real quick battle!")
        waitmessage
        goto(GerbonTown_OutdoorBattleJordanAsk)
    }
}

script GerbonTown_OutdoorBattleTrigger{
    setflag(FLAG_NO_WHITEOUT)
    if (var(VAR_STARTER_MON) == 0) { // Starter is Pansear
        trainerbattle(
            TRAINER_BATTLE_CONTINUE_SCRIPT,
            GERBON_TOWN_JORDAN_FIRSTBATTLE,
            TRAINER_BRENDAN_ROUTE_103_TREECKO,
            "That's what I'm talking about! Let's go!",
            "Wow {PLAYER}, I didn't know you could
            battle like that!",
            GerbonTown_OutdoorBattleEnd,
            LOCALID_NONE,
            TRAINER_NONE,
            NULL,
            NULL,
            NULL,
            NULL,
            NULL,
            FALSE,
            TRUE,
            FALSE,
            FALSE,
        )
    }
    elif (var(VAR_STARTER_MON) == 1) { // Starter is Pansage
        trainerbattle(
            TRAINER_BATTLE_CONTINUE_SCRIPT,
            GERBON_TOWN_JORDAN_FIRSTBATTLE,
            TRAINER_BRENDAN_ROUTE_110_MUDKIP,
            "That's what I'm talking about! Let's go!",
            "Wow {PLAYER}, I didn't know you could
            battle like that!",
            GerbonTown_OutdoorBattleEnd,
            LOCALID_NONE,
            TRAINER_NONE,
            NULL,
            NULL,
            NULL,
            NULL,
            NULL,
            FALSE,
            TRUE,
            FALSE,
            FALSE,
        )
    }
    elif (var(VAR_STARTER_MON) == 2) { // Starter is Panpour
        trainerbattle(
            TRAINER_BATTLE_CONTINUE_SCRIPT,
            GERBON_TOWN_JORDAN_FIRSTBATTLE,
            TRAINER_BRENDAN_ROUTE_119_MUDKIP,
            "That's what I'm talking about! Let's go!",
            "Wow {PLAYER}, I didn't know you could
            battle like that!",
            GerbonTown_OutdoorBattleEnd,
            LOCALID_NONE,
            TRAINER_NONE,
            NULL,
            NULL,
            NULL,
            NULL,
            NULL,
            FALSE,
            TRUE,
            FALSE,
            FALSE,
        )
    }
    elif (var(VAR_STARTER_MON) == 3) { // Starter is Innonk
        trainerbattle(
            TRAINER_BATTLE_CONTINUE_SCRIPT,
            GERBON_TOWN_JORDAN_FIRSTBATTLE,
            TRAINER_BRENDAN_ROUTE_103_MUDKIP,
            "That's what I'm talking about! Let's go!",
            "Wow {PLAYER}, I didn't know you could
            battle like that!",
            GerbonTown_OutdoorBattleEnd,
            LOCALID_NONE,
            TRAINER_NONE,
            NULL,
            NULL,
            NULL,
            NULL,
            NULL,
            FALSE,
            TRUE,
            FALSE,
            FALSE,
        )
    }
}

script GerbonTown_OutdoorBattleEnd {
    clearflag(FLAG_NO_WHITEOUT)
    special(HealPlayerParty)
    lock
    faceplayer
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    specialvar(VAR_RESULT, GetBattleOutcome)
    setspeaker("Jordan")
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        msgbox("You must have been practicing, I
                thought I had that in the bag!")
        waitmessage
    } else {
       msgbox("Whew, that was a close one! Looks like
                my training has paid off! I bet you
                didn't expect that huh?")
        waitmessage 
    }
    msgbox("I've been thinking, maybe we should try
            to challenge the {COLOR RED}Battle Ace{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} of Gerbon
            Town. That's Julia, one of the trainers
            we just watched!

            Every two years, there is a
            tournament in each of the stadiums.
            Sinvesta calls it a {COLOR RED}Showcase
            Tournament{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}. Whoever wins gets to face
            the current {COLOR RED}Battle Ace{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}. It's a great way
            to test your skill!
            
            I think we need to train our Pokemon
            though. I don't think either of us would
            even be able to make it to the end of
            tournament!
            
            Meet me at the entrance to {COLOR RED}
            Sawgrass Forest{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}, just south of my
            house! We'll be able to train our
            Pokemon there!

            See you soon!")
    waitmessage
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    setflag(FLAG_GERBON_TOWN_JORDAN_FIRSTBATTLE)
    removeobject(GERBON_TOWN_JORDAN_FIRSTBATTLE)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)

    // Disable blockers of Sawngrass Village south exit
    setflag(FLAG_SAWGRASS_SOUTH_BLOCKERS)
    removeobject(ZED_Sawgrass_Blockage_Sailor, MAP_LITTLEROOT_TOWN)
    removeobject(ZED_Sawgrass_Blockage_Fearow, MAP_LITTLEROOT_TOWN)

    // Let player know about level cap
    setflag(FLAG_CAP_BEFORE_FIRSTRIVAL)
    playfanfare(MUS_LEVEL_UP)
    msgbox("The level cap has been raised to 18!", MSGBOX_SIGN)
    waitfanfare
    waitmessage

    // Show messagebox that main quest is updated, and play chime
    questupdated(0)

    release
}

//// Palladium Tournament

script GerbonTownTourney_JordanStartOutside {
    lock
    faceplayer
    setspeaker("Jordan")
    msgbox("There you are! It's time to start the
            tournament! I should explain exactly
            how it works, eh? That would be helpful.
            
            16 trainers are entering, and you will
            battle a total of four trainers.
            Then, you'll be facing the {COLOR RED}Battle Ace{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY},
            Julia!

            When the tournament starts, you'll be in
            the prep room, where you'll be able to
            heal up, and start your next match.
            
            Are you ready to go? You
            can't leave once the tournament has
            started!", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        setspeaker("Jordan")
        msgbox("Great! Let's go!")
        waitmessage
        setflag(FLAG_GERBON_FIRSTSHOW_JULIA)
        setflag(FLAG_GERBON_FIRSTSHOW_CANDACE)
        setflag(FLAG_GERBON_FIRSTSHOW_GOLEM)
        setflag(FLAG_CANDACE01_MON2)
        setvar(VAR_GERBON_TOURNAMENT_STATE, 1)
        setvar(VAR_ZED_STORY_TRACKER, 8)
        warp(MAP_GERBON_TOWN_BATTLE_HALL_PREP_ROOM, 4, 5)
        waitstate
        release
        end
    }
}

// After the tournament, Jordan guides player North of Gerbon Town
script GerbonTownTourney_JordanAfter {
    lock
    faceplayer
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    setspeaker("Jordan")
    msgbox("That was amazing! I'm a little miffed
            that I didn't win, but I can't deny what
            I bore witness to! I said it before, but
            you must have really been practicing!

            Honestly, it's pretty rare for someone
            to beat a Battle Ace, they're supposed
            to be the best of the best! I think you
            surpised a lot of people just now!
            
            I can't let you get away with that by
            yourself, I'm going to get you next
            time! That's right, we're going to battle
            in the next tournament in {COLOR RED}Woltia City{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}!
            
            ...
            
            I'll get you back for the rest of the
            meal, I promi-")
    waitmessage
    applymovement(GERBON_TOWN_JORDAN_FIRSTBATTLE, moves(emote_exclamation_mark))
    playse(SE_PIN)
    waitmovement
    waitse
    setspeaker("Jordan")
    msgbox("Ah I completely forgot! This ought to
            cover that meal in full!")
    waitmessage
    giveitem(ITEM_ULTRA_REPEL, 1)
    waitmessage
    setspeaker("Jordan")
    msgbox("That Repel is awesome! It's new tech
            from a local company in Vulias, you
            probably have not heard of it!
            
            It's like any normal Repel, but it never
            runs out! Turn it on from your {COLOR RED}Key
            Items{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} pouch, and it will stay on until
            you turn it off! Very useful!
            
            I suppose I should have gotten you one
            of these earlier, none of the Marts in
            Vulias sell normal Repels anymore
            because everyone has one of these!")
    waitmessage
    setspeaker("Jordan")
    msgbox("Anyways, Woltia City
            is North and then west, through
            {COLOR RED}Route 102, and Mullen Cave{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}.
            
            Mullen Cave is full of Pokemon, so we'll
            find lots of new partners. Maybe I'll
            see you while I'm there. Catch you
            later {PLAYER}!")
    applymovement(GERBON_TOWN_JORDAN_FIRSTBATTLE, moves(
        walk_down, walk_left * 12
    ))
    delay(40)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    waitmovement(GERBON_TOWN_JORDAN_FIRSTBATTLE)
    setvar(VAR_ZED_STORY_TRACKER, 10)
    setflag(FLAG_SYS_TV_START)
    setvar(VAR_INTERVIEWS_STORY, 1)
    setflag(FLAG_GERBON_TOWN_JORDAN_FIRSTBATTLE)
    removeobject(GERBON_TOWN_JORDAN_FIRSTBATTLE)

    // Disable the cops blocking Mullen Cave
    setflag(FLAG_ROUTE102_STAIRBLOCKERS)

    questupdated(0)

    delay(20)
    goto(GerbonTownTourney_InterviewAfterGerbonWin)
    end
}

script GerbonTownTourney_InterviewAfterGerbonWin
{
    applymovement(GERBON_INTERVIEW01_INTERVIEWER, moves(walk_down, walk_left * 2))
    applymovement(GERBON_INTERVIEW01_CAMERAMAN, moves(walk_down * 2, walk_left * 3))
    waitmovement(GERBON_INTERVIEW01_CAMERAMAN)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark, face_right))
    playse(SE_PIN)
    waitse
    setspeaker("Interviewer")
    call(BattleHall_EventScript_InterviewStart)
    lock
    setspeaker("Interviewer")
    msgbox("Thank you for your time! We hope to see
            you again soon!")
    waitmessage
    closemessage
    applymovement(GERBON_INTERVIEW01_CAMERAMAN, moves(walk_right, face_left))
    waitmovement
    applymovement(GERBON_INTERVIEW01_INTERVIEWER, moves(walk_down, walk_left * 10))
    delay(60)
    applymovement(GERBON_INTERVIEW01_CAMERAMAN, moves(walk_left * 11))
    waitmovement(GERBON_INTERVIEW01_INTERVIEWER)
    waitmovement(GERBON_INTERVIEW01_CAMERAMAN)
    removeobject(GERBON_INTERVIEW01_INTERVIEWER)
    removeobject(GERBON_INTERVIEW01_CAMERAMAN)
    setvar(VAR_INTERVIEWS_STORY, 2)
    release
}

//// Other NPCs in exteriors and interiors

// Exterior NPCs

// Mom and Kid from Ruvel Pyramid
script GerbonTown_EventScript_RuvelKid {
    lock
    faceplayer
    setspeaker("Child")
    if (var(VAR_ZED_STORY_TRACKER) < 24) {
        msgbox("I'm so excited! My mommy is going taking
                me to visit a {COLOR RED}Pyramid!{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}
                
                I hope it's not too scary!")
    }
    else {
        msgbox("It's the mister from the Pyramid! Thank
                you for saving me from that scary
                Pokemon! My mommy doesn't want to take
                me on vacation anymore though!")
    }
    waitmessage
    release
    end
}

script GerbonTown_EventScript_RuvelKidMom {
    lock
    faceplayer
    setspeaker("Happy Mom")
    if (var(VAR_ZED_STORY_TRACKER) < 24) {
        msgbox("I always make sure to let me daughter
                see the world! It's important that
                she has a wide range of experiences!")
    }
    else {
        msgbox("My daughter's savior! Thank you again!
                I'm glad to see you are well!
        
                I've decided my duaghter will not leave
                town until she has her own Pokemon! I
                can't allow her to experience such a
                thing again!")
    }
    waitmessage
    release
    end
}

// Triathelete house with Linoone - gives Macho Brace
script GerbonTown_EventScript_TriathleteHouseMan {
    lock
    faceplayer
    setspeaker("Athlete")
    if (!flag(FLAG_GERBON_GOT_MACHO)) {
        msgbox("It's important to train yourself, and
            your Pokemon! Look at Linoone go!")
        waitmessage
        playmoncry(SPECIES_LINOONE, CRY_MODE_NORMAL)
        setspeaker("Linoone")
        msgbox("Greeee-ah")
        waitmoncry
        waitmessage
        setspeaker("Athlete")
        msgbox("Here, this can help you make your
                Pokemon as strong as they can be!")
        waitmessage
        giveitem(ITEM_MACHO_BRACE, 1)
        setflag(FLAG_GERBON_GOT_MACHO)
        msgbox("If a Pokemon holds that, they'll get
                much stronger than normal! Use it to
                make sure you're always ready for the
                next opponent!")
        waitmessage
    } else {
        msgbox("Keep on training my friend!")
        waitmessage
    }
    
    release
    end
}

script GerbonTown_EventScript_TriathleteHouseLinoone {
    lock
    faceplayer
    playmoncry(SPECIES_LINOONE, CRY_MODE_NORMAL)
    setspeaker("Linoone")
    msgbox("Greeee-ah")
    waitmoncry
    waitmessage
    release
    end
}

